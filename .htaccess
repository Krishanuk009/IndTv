# Prevent directory listing
Options -Indexes

# Set PHP 8 compatible settings (Common on InfinityFree)
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
    php_value display_errors Off
</IfModule>

# Protect system files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>